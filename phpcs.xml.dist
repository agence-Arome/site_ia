<?xml version="1.0"?>
<ruleset name="Expert WP">
  <description>WordPress Coding Standards, thème et extension.</description>
  <file>wp-content</file>
  <arg name="extensions" value="php"/>
  <arg name="basepath" value="."/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties><property name="custom_capabilities" type="array"><element value="manage_ewp_leads"/></property></properties>
  </rule>
  <config name="minimum_supported_wp_version" value="6.8"/>
</ruleset>
