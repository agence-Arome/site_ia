{
  "$schema":"https://schemas.wp.org/wp/6.8/theme.json","version":3,
  "settings":{
    "appearanceTools":true,"useRootPaddingAwareAlignments":true,
    "layout":{"contentSize":"760px","wideSize":"1200px"},
    "color":{"defaultPalette":false,"palette":[
      {"slug":"navy","color":"#101e35","name":"Bleu nuit"},
      {"slug":"electric","color":"#2454e8","name":"Bleu électrique"},
      {"slug":"ice","color":"#eef3ff","name":"Bleu léger"},
      {"slug":"paper","color":"#f8f9fc","name":"Papier"},
      {"slug":"white","color":"#ffffff","name":"Blanc"},
      {"slug":"muted","color":"#536078","name":"Texte secondaire"}
    ]},
    "typography":{"fluid":true,"fontFamilies":[{"slug":"system","name":"Système","fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"}],"fontSizes":[
      {"slug":"small","size":"0.875rem","name":"Petit"},{"slug":"medium","size":"1rem","name":"Normal"},{"slug":"large","size":"1.25rem","name":"Introduction"},
      {"slug":"x-large","size":"2.6rem","name":"Titre de section","fluid":{"min":"2rem","max":"2.6rem"}},
      {"slug":"hero","size":"5rem","name":"Grand titre","fluid":{"min":"2.65rem","max":"5rem"}}
    ]},
    "spacing":{"units":["px","rem","%","vw"],"spacingSizes":[{"slug":"20","size":"1rem","name":"S"},{"slug":"30","size":"1.5rem","name":"M"},{"slug":"40","size":"2rem","name":"L"},{"slug":"50","size":"3rem","name":"XL"},{"slug":"60","size":"5.5rem","name":"Section"}]}
  },
  "styles":{
    "color":{"background":"var:preset|color|paper","text":"var:preset|color|navy"},
    "typography":{"fontFamily":"var:preset|font-family|system","fontSize":"1rem","lineHeight":"1.7"},
    "spacing":{"padding":{"left":"clamp(1.2rem,4vw,3rem)","right":"clamp(1.2rem,4vw,3rem)"},"blockGap":"1.5rem"},
    "elements":{
      "heading":{"typography":{"fontWeight":"650","lineHeight":"1.12","letterSpacing":"-0.04em"}},
      "h1":{"typography":{"fontSize":"var:preset|font-size|hero"}},
      "h2":{"typography":{"fontSize":"var:preset|font-size|x-large"}},
      "h3":{"typography":{"fontSize":"1.5rem","lineHeight":"1.25"}},
      "link":{"color":{"text":"var:preset|color|electric"}},
      "button":{"color":{"background":"var:preset|color|electric","text":"var:preset|color|white"},"border":{"radius":"6px"},"spacing":{"padding":{"top":".9rem","right":"1.4rem","bottom":".9rem","left":"1.4rem"}},"typography":{"fontSize":"1rem","fontWeight":"600"}}
    },
    "blocks":{"core/site-title":{"typography":{"fontSize":"1.3rem","fontWeight":"750","letterSpacing":"-0.045em"}},"core/navigation":{"typography":{"fontSize":".9rem","fontWeight":"550"}},"core/post-title":{"typography":{"fontSize":"2.5rem"}}}
  },
  "templateParts":[{"name":"header","title":"En-tête","area":"header"},{"name":"footer","title":"Pied de page","area":"footer"}],
  "customTemplates":[{"name":"service","title":"Page de service","postTypes":["page"]},{"name":"landing","title":"Page sans titre automatique","postTypes":["page"]}]
}
